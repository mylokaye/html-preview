{
  "name": "vs-html-preview",
  "displayName": "VS HTML Preview",
  "description": "Preview HTML files in a browser-like VS Code panel, including GitHub remote workspaces.",
  "version": "0.1.3",
  "publisher": "MyloKaye",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mylokaye/vs-preview.git"
  },
  "bugs": {
    "url": "https://github.com/mylokaye/vs-preview/issues"
  },
  "homepage": "https://mylokaye.me",
  "galleryBanner": {
    "color": "#4338CA",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "html",
    "htm",
    "html preview",
    "html viewer",
    "preview",
    "live preview",
    "browser preview",
    "browser",
    "web preview",
    "webview",
    "web development",
    "frontend",
    "css",
    "javascript",
    "github",
    "github repositories",
    "github remote",
    "remote workspace",
    "remote development",
    "virtual workspace",
    "vscode web",
    "static website",
    "web page preview",
    "live reload"
  ],
  "main": "./extension.js",
  "browser": "./extension.js",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "vsPreview.openPreview",
        "title": "Preview HTML"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vsPreview.openPreview",
          "when": "resourceLangId == html",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "vsPreview.openPreview",
          "when": "resourceLangId == html",
          "group": "navigation"
        }
      ]
    }
  }
}
